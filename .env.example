# 手元実行用の環境変数テンプレート。
# 実際にはこのファイルを .env という名前でコピーして値を入れる(gitignore 済み)。
# npm run scrape / notify / batch は .env があれば自動で読み込む。

# 実サイトのドメイン(未設定ならモックモード)。
# ドメインのみ(例: https://example.com / example.com)ならパス・クエリは
# 設定(config.targetUrl)から補完。フル URL を書けばそちらが優先
SCRAPER_DOMAIN=

# 巡回キーワード(カンマ区切り。例: 梅田,天王寺)
SCRAPER_KEYWORDS=

# 詳細取得スレ数の上限(手元の動作確認用。未設定なら全件)
# SCRAPER_MAX_THREADS=3

# 通知(系統②)。両方設定しないと notify は投稿をスキップする
GIST_TOKEN=
DISCORD_WEBHOOK_URL=