{
  // Cloudflare Workers 設定。
  // サイト本体は site/ 以下の静的アセットとして配信し、
  // /data/* の JSON はアクセス時に Worker がリアルタイムで
  // スクレイピングして生成する(worker/src/scrape.ts)。
  "name": "board-mirror",
  "main": "worker/src/worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // 静的データはもう存在しないため、/data/* は常に Worker が処理する
    "run_worker_first": ["/data/*"]
  },
  // scraper/mock/*.html を文字列として import するためのルール
  "rules": [{ "type": "Text", "globs": ["**/*.html"] }],
  // GitHub Actions の schedule は高頻度 cron が間引かれる(実勢 2〜4 時間おき)ため、
  // Cloudflare Cron から workflow_dispatch で scrape.yml を 10 分おきに確実に起動する
  // (scheduled ハンドラ。トークン GH_DISPATCH_TOKEN は deploy.yml が同期)
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}